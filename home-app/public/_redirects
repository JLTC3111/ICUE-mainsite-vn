# Newsroom React app (history routing) lives at /newsroom.
# Static files under /newsroom/assets/* are served as-is when present.
# SPA fallback applies only to extensionless routes (not missing .js/.css files).

# Market ticker API — must be before the /newsroom/* SPA catch-all.
/newsroom/api/market-quotes  /.netlify/functions/market-quotes  200
/newsroom/api/market-quotes-vn  /.netlify/functions/market-quotes?scope=vn  200
/newsroom/api/auth-forgot-password  /.netlify/functions/auth-forgot-password  200
/newsroom/api/gemini-article  /.netlify/functions/gemini-article  200
/newsroom/api/flux-image  /.netlify/functions/flux-image  200

/newsroom            /newsroom/index.html   200
/newsroom/login      /newsroom/index.html   200
/newsroom/write      /newsroom/index.html   200
/newsroom/edit/*     /newsroom/index.html   200
/newsroom/dashboard  /newsroom/index.html   200
/newsroom/assist     /newsroom/index.html   200
/newsroom/profile    /newsroom/index.html   200
/newsroom/article/*  /newsroom/index.html   200
/newsroom/*          /newsroom/index.html   200

# People React app (history routing) lives at /people.
/people              /people/index.html   200
/people/*            /people/index.html   200

# Structure React app (history routing) lives at /structure.
/structure           /structure/index.html   200
/structure/*         /structure/index.html   200

# Our Work React app (history routing) lives at /our-work. It replaces both the
# vi and en legacy carousel pages, and serves all six UI languages itself.
/our-work            /our-work/index.html    200
/our-work/*          /our-work/index.html    200

# Contact React app lives at /contact. It replaces the legacy Contact.html page
# and the crawlable route shell — its own index.html carries the meta, the
# structured data and a no-JS fallback with the address and the number.
/contact             /contact/index.html     200
/contact/*           /contact/index.html     200

# FAQ React app lives at /faqs. It replaces the legacy FAQs.html page and the
# crawlable route shell — its own index.html carries the meta, FAQPage
# structured data and a no-JS fallback with every question and answer.
/faqs                /faqs/index.html        200
/faqs/*              /faqs/index.html        200

# Recruitment React app lives at /recruitment. It owns the whole namespace,
# photographs included (/recruitment/media/*), because it builds there with
# emptyOutDir. Its index.html carries JobPosting data for each open role.
# Like /newsroom/* below, the splat is a fallback: real files under
# /recruitment/assets/* and /recruitment/media/* are served as-is when present.
/recruitment         /recruitment/index.html    200
/recruitment/*       /recruitment/index.html    200

# Community Activities React app lives at /community-activities. It replaces the
# legacy communityActivities.html page and its crawlable shell — its own
# index.html carries the meta, CollectionPage data and a no-JS fallback listing
# every programme. Like /newsroom/* below, the splat is a fallback: real files
# under /community-activities/{assets,media}/* are served as-is when present.
/community-activities    /community-activities/index.html   200
/community-activities/*  /community-activities/index.html   200

# Consolidated legal React app. All four documents share one bundle and use
# route-aware tabs at /legal/privacy, /legal/terms, /legal/gdpr and /legal/cookies.
/legal               /legal/index.html       200
/legal/privacy       /legal/privacy/index.html  200
/legal/terms         /legal/terms/index.html    200
/legal/gdpr          /legal/gdpr/index.html     200
/legal/cookies       /legal/cookies/index.html  200
/legal/*             /legal/index.html       200

