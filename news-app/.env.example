# Supabase project credentials (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Cloud Translation API v2 key — required on Netlify for /api/translate-article
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# Service role key — recommended on Netlify so translations are cached in Supabase.
# Supabase URL + anon key for the translate function are read from
# newsroom/supabase-config.json at deploy time if not set here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DeepL — disabled for now (set DEEPL_ENABLED in translateProviders.js when ready)
# DEEPL_API_KEY=your-deepl-api-key

# The prebuild step writes these into public/supabase-config.json so production
# can load Supabase at runtime even when Netlify env vars are missing.
# Commit public/supabase-config.json after running `npm run build` locally,
# or set the same values in Netlify -> Site settings -> Environment variables.

# Also set on Netlify (Site settings -> Environment) for serverless functions:
# SUPABASE_URL=<same as VITE_SUPABASE_URL>
# SUPABASE_ANON_KEY=<same as VITE_SUPABASE_ANON_KEY>
# SUPABASE_SERVICE_ROLE_KEY=<service role — translate cache writes>
# GOOGLE_TRANSLATE_API_KEY=<Cloud Translation API key>
# DEEPL_API_KEY=<optional — not used while DeepL is disabled>
