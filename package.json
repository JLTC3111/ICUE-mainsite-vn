{
  "name": "icue-main-site-vietnamese",
  "version": "1.0.0",
  "description": "ICUE Website with Stripe Integration",
  "main": "server.js",
  "dependencies": {
    "@google/model-viewer": "^4.1.0",
    "@tailwindcss/vite": "^4.1.7",
    "aos": "^2.3.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "normalize.css": "^8.0.1",
    "ogl": "^1.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^12.0.0",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "cpy": "^11.1.0",
    "nodemon": "^2.0.22",
    "vite": "^6.3.2"
  },
  "scripts": {
    "dev": "npm run build:home && npm run build:newsroom && node scripts/sync-home-dev.mjs && vite",
    "install:apps": "npm ci --prefix news-app && npm ci --prefix people-app && npm ci --prefix structure-app && npm ci --prefix home-app",
    "build": "npm run install:apps && npm run build:home && npm run build:newsroom && npm run build:people && npm run build:structure && node scripts/postbuild.mjs",
    "dev:legacy": "node scripts/restore-dev-index.mjs && vite",
    "preview": "vite preview",
    "server": "node server.js",
    "server-dev": "nodemon server.js",
    "build:newsroom": "npm run build --prefix news-app",
    "dev:newsroom": "npm run dev --prefix news-app",
    "build:people": "npm run build --prefix people-app",
    "dev:people": "npm run dev --prefix people-app",
    "build:structure": "npm run build --prefix structure-app",
    "dev:home": "npm run dev --prefix home-app",
    "build:home": "npm run build --prefix home-app",
    "dev:structure": "npm run dev --prefix structure-app"
  }
}
