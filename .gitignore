.DS_Store
**/.DS_Store
# Dependencies are installed by the build (npm ci) — never commit them.
node_modules/
/.cache/
*.local

# Vite / postbuild output. Netlify runs `npm run build` and publishes `dist-home/`.
# `dist` does not match dist-home or sibling-app outDirs (newsroom, people, …).
dist
dist-ssr
dist-home/

# Certificate assets are synced from public/certs before home-app dev/build.
/home-app/public/certs/

# Background music is copied from public/music for the home dev server.
/home-app/public/music/

# Home-app hashed bundles and generated HTML copied to repo root by postbuild.
/assets/
/route-shells/
/index.html

# Root/mobile icons are generated from public/logoIcons/ during app dev/build.
/favicon.png
/favicon.ico
/apple-touch-icon.png
/apple-touch-icon-precomposed.png
/home-app/public/favicon.png
/home-app/public/favicon.ico
/home-app/public/apple-touch-icon.png
/home-app/public/apple-touch-icon-precomposed.png

# Content-addressed icon copies are generated from public/logoIcons/.
/*-app/public/favicon*.ico
/*-app/public/favicon*.png
/*-app/public/apple-touch-icon*.png
/favicon-*.png
/favicon-*.ico
/apple-touch-icon-*.png

# Home and Legal also mirror the canonical logoIcons directory for legacy links.
/home-app/public/logoIcons/apple-touch-icon.png
/home-app/public/logoIcons/apple-touch-icon-precomposed.png
/home-app/public/logoIcons/favicon-browser.png
/home-app/public/logoIcons/favicon.ico
/legal-app/public/logoIcons/apple-touch-icon.png
/legal-app/public/logoIcons/apple-touch-icon-precomposed.png
/legal-app/public/logoIcons/favicon-browser.png
/legal-app/public/logoIcons/favicon.ico

# Sibling-app Vite outDirs. Source lives in *-app/; public assets stay in public/.
/newsroom/
/people/
/structure/
/our-work/
/contact/
/legal/
/faqs/
/recruitment/
/community-activities/

# Environment (secrets — never commit)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

!public/fonts/.gitkeep
